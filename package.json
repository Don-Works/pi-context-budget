{
  "name": "pi-context-budget",
  "version": "0.2.0",
  "description": "Pi coding-agent extension that keeps long sessions inside the window a local model works best in: archives old thinking and stale tool outputs as addressable snapshots, with no LLM calls and nothing paraphrased.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Don-Works/pi-context-budget.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "context-window",
    "pruning",
    "compaction",
    "vllm"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test plan.test.mjs"
  },
  "engines": {
    "node": ">=23"
  },
  "files": [
    "index.ts",
    "plan.ts",
    "replay.ts",
    "context-budget.example.json",
    "README.md",
    "LICENSE"
  ]
}
